# ===== 서버 =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ===== 데이터베이스 =====
# 비어있으면 Embedded PostgreSQL 자동 사용
DATABASE_URL=
# Embedded PG 데이터 디렉토리 (기본: .embedded-pg)
EMBEDDED_PG_DIR=.embedded-pg

# ===== 인증 =====
# local_trusted: 로컬 단독 실행 (인증 없음)
# authenticated: Better Auth 세션 기반
AUTH_MODE=local_trusted
# Better Auth 비밀키 (AUTH_MODE=authenticated 일 때만 필요)
BETTER_AUTH_SECRET=

# ===== 자율도 =====
# 기본 자율도 레벨 (1=Manual, 2=Confirm, 3=Notify, 4=Auto)
DEFAULT_AUTONOMY_LEVEL=4

# ===== 로깅 =====
# trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# true: 사람이 읽기 쉬운 포맷 (개발용)
LOG_PRETTY=true

# ===== 확장 (선택) =====
# Redis URL (없으면 인메모리 큐/이벤트 사용)
REDIS_URL=
# 파일 저장 경로 (기본: ./storage)
STORAGE_DIR=./storage
# 시크릿 암호화 키 (32바이트 hex)
SECRETS_ENCRYPTION_KEY=

# ===== OAuth (선택) =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Letro 모드 =====
# local: 로컬 단독 실행 (기본)
# cloud: 유료 클라우드 모드 (private/ 전용)
LETRO_MODE=local
